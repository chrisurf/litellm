# LiteLLM Environment Configuration
# Copy this file to .env and update with your actual values

# ==============================================
# OpenAI Configuration (Primary)
# ==============================================
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================
# PostgreSQL Database Configuration (Required for Web UI)
# ==============================================
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=your-secure-postgres-password-here

# ==============================================
# LiteLLM Configuration (Required for Authentication)
# ==============================================
LITELLM_MASTER_KEY=your-secure-master-key-here

# ==============================================
# Web UI Configuration (Required for Admin Access)
# ==============================================
UI_USERNAME=admin
UI_PASSWORD=your-secure-ui-password-here

# ==============================================
# Optional: Azure OpenAI Configuration
# ==============================================
# AZURE_API_KEY=your-azure-api-key-here
# AZURE_API_BASE=https://your-resource-name.openai.azure.com/

# ==============================================
# Optional: Other LLM Providers
# ==============================================

# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google AI (Gemini)
# GOOGLE_API_KEY=your-google-api-key-here

# Cohere
# COHERE_API_KEY=your-cohere-api-key-here

# ==============================================
# Optional: LiteLLM Advanced Configuration
# ==============================================

# Master key for authentication (recommended for production)
# LITELLM_MASTER_KEY=your-secure-master-key-here

# External Database URL (if not using built-in PostgreSQL)
# DATABASE_URL=postgresql://username:password@external-host:5432/litellm_db

# Redis URL for caching
# REDIS_URL=redis://localhost:6379

# ==============================================
# Optional: Advanced Settings
# ==============================================

# Set log level (DEBUG, INFO, WARNING, ERROR)
# LITELLM_LOG_LEVEL=INFO

# Enable request logging
# LITELLM_REQUEST_LOGGING=true

# Set custom port (default: 4000)
# LITELLM_PORT=4000

# Number of workers (default: 1)
# LITELLM_NUM_WORKERS=8